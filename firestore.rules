rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset enforces a strict ownership and role-based access model for the Grubbie application. 
     * It leverages denormalization (storing IDs like vendorId and customerId directly on documents) 
     * to ensure authorization is fast, independent, and does not require recursive 'get()' calls.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isInvolvedInOrder(orderData) {
      return isSignedIn() && (request.auth.uid == orderData.customerId || request.auth.uid == orderData.vendorId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the top-level User documents.
     */
    match /users/{userId} {
      // Allow reading other users if the requester is signed in 
      // OR if the document belongs to a vendor (needed for public menu discovery).
      allow get, list: if isSignedIn() || (resource != null && resource.data.userType == 'vendor');
      
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      /**
       * @description Subcollection for Customer-specific profile data.
       */
      match /customerProfile/{profileId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      /**
       * @description Subcollection for Vendor-specific profile data (Hierarchy access).
       */
      match /vendorProfile/{profileId} {
        allow read: if true;
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if (isExistingOwner(userId) && request.resource.data.userId == userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    /**
     * @description Collection Group match for Vendor discovery.
     */
    match /{path=**}/vendorProfile/{profileId} {
      allow read: if true;
    }

    /**
     * @description Global administrative role verification.
     */
    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Categories for food items (e.g., 'Cafeteria').
     */
    match /menuTypes/{menuTypeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Food items offered by vendors.
     */
    match /menuItems/{menuItemId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.vendorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    /**
     * @description Customer pre-orders.
     */
    match /orders/{orderId} {
      allow get, list: if isInvolvedInOrder(resource.data) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if resource != null && (isInvolvedInOrder(resource.data) || isAdmin());
      allow delete: if isAdmin();

      match /orderItems/{orderItemId} {
        allow get, list: if isInvolvedInOrder(get(/databases/$(database)/documents/orders/$(orderId)).data) || isAdmin();
        allow create, update, delete: if isInvolvedInOrder(get(/databases/$(database)/documents/orders/$(orderId)).data) || isAdmin();
      }
    }

    /**
     * @description Ratings and written reviews.
     */
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if resource != null && (resource.data.customerId == request.auth.uid || isAdmin());
      allow delete: if resource != null && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    /**
     * @description Reports submitted by vendors against customer behavior.
     */
    match /reports/{reportId} {
      allow get: if (isSignedIn() && resource.data.reportingVendorId == request.auth.uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reportingVendorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}