
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset enforces a strict ownership and role-based access model for the Grubbie application. 
     * It leverages denormalization to ensure authorization is fast and independent.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /**
     * Checks if the current user is involved in an order.
     * Vendors are allowed even if not email verified (per admin-creation flow).
     * Customers MUST be email verified to access order details.
     */
    function isInvolvedInOrder(orderData) {
      return isSignedIn() && (
        (request.auth.uid == orderData.vendorId) || 
        (request.auth.uid == orderData.customerId && isEmailVerified())
      );
    }

    // --- Collection Group Rules ---
    
    // Explicitly allow collection group queries for vendor discovery
    match /{path=**}/vendorProfile/{profileId} {
      allow read: if true;
    }

    match /{path=**}/customerProfile/{profileId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the top-level User documents.
     */
    match /users/{userId} {
      // Vendors are publicly visible.
      allow get: if isOwner(userId) || isEmailVerified() || (resource != null && resource.data.userType == 'vendor') || isAdmin();
      allow list: if isEmailVerified() || (resource != null && resource.data.userType == 'vendor') || isAdmin();
      
      // Allow creation during signup or by admin
      allow create: if isOwner(userId) || isAdmin();
      // Allow owners to update their base doc (needed for profile synchronization and status updates)
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if (isOwner(userId) && isEmailVerified()) || isAdmin();

      /**
       * @description Subcollection for Customer-specific profile data.
       */
      match /customerProfile/{profileId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if (isOwner(userId) && isEmailVerified()) || isAdmin();
        
        allow create: if (isOwner(userId) && isEmailVerified()) || isAdmin();
        allow update: if (isExistingOwner(userId) && isEmailVerified()) || isAdmin();
        allow delete: if (isOwner(userId) && isEmailVerified()) || isAdmin();
      }

      /**
       * @description Subcollection for Vendor-specific profile data.
       */
      match /vendorProfile/{profileId} {
        allow read: if true;
        // Vendors bypass email verification for profile management as they are admin-created
        allow create: if isOwner(userId) || isAdmin();
        allow update: if isExistingOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    /**
     * @description Global administrative role verification.
     */
    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Categories for food items.
     */
    match /menuTypes/{menuTypeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Food items offered by vendors.
     */
    match /menuItems/{menuItemId} {
      allow get, list: if true;
      // Vendors bypass email verification for menu management
      allow create: if isSignedIn() && (request.resource.data.vendorId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.vendorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    /**
     * @description Customer pre-orders.
     */
    match /orders/{orderId} {
      allow get: if (resource != null && isInvolvedInOrder(resource.data)) || isAdmin();
      // Allow vendors to list their orders even without verification; customers still need it
      allow list: if (isSignedIn() && (
        (resource.data.vendorId == request.auth.uid) || 
        (resource.data.customerId == request.auth.uid && isEmailVerified())
      )) || isAdmin();
      
      allow create: if isEmailVerified() && request.resource.data.customerId == request.auth.uid;
      allow update: if resource != null && (isInvolvedInOrder(resource.data) || isAdmin());
      allow delete: if isAdmin();

      match /orderItems/{orderItemId} {
        allow get, list: if isInvolvedInOrder(get(/databases/$(database)/documents/orders/$(orderId)).data) || isAdmin();
        allow create, update, delete: if isInvolvedInOrder(get(/databases/$(database)/documents/orders/$(orderId)).data) || isAdmin();
      }
    }

    /**
     * @description Ratings and written reviews.
     */
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isEmailVerified() && request.resource.data.customerId == request.auth.uid;
      allow update: if resource != null && isEmailVerified() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow delete: if resource != null && isEmailVerified() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    /**
     * @description Reports submitted by vendors.
     */
    match /reports/{reportId} {
      // Vendors bypass email verification for report access
      allow get: if (isSignedIn() && resource.data.reportingVendorId == request.auth.uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reportingVendorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
