
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset enforces a strict ownership and role-based access model for the Grubbie application. 
     * It leverages denormalization to ensure authorization is fast and independent.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isInvolvedInOrder(orderData) {
      return isEmailVerified() && (request.auth.uid == orderData.customerId || request.auth.uid == orderData.vendorId);
    }

    // --- Collection Group Rules ---
    
    // Explicitly allow collection group queries for vendor discovery
    match /{path=**}/vendorProfile/{profileId} {
      allow read: if true;
    }

    match /{path=**}/customerProfile/{profileId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the top-level User documents.
     */
    match /users/{userId} {
      // Vendors are publicly visible.
      // Everyone can get a vendor's doc if they query for it.
      // Everyone can list users IF they only ask for vendors.
      allow get: if isOwner(userId) || isEmailVerified() || (resource != null && resource.data.userType == 'vendor');
      allow list: if isEmailVerified() || (resource != null && resource.data.userType == 'vendor');
      
      // Allow creation during signup
      allow create: if isOwner(userId);
      allow update: if (isExistingOwner(userId) && isEmailVerified()) || isAdmin();
      allow delete: if (isOwner(userId) && isEmailVerified()) || isAdmin();

      /**
       * @description Subcollection for Customer-specific profile data.
       */
      match /customerProfile/{profileId} {
        // Relax get permission to allow the login check for unverified owners
        allow get: if isOwner(userId) || isAdmin();
        allow list: if (isOwner(userId) && isEmailVerified()) || isAdmin();
        allow create: if isOwner(userId) && isEmailVerified() && request.resource.data.userId == userId;
        allow update: if (isExistingOwner(userId) && isEmailVerified() && request.resource.data.userId == userId) || isAdmin();
        allow delete: if (isOwner(userId) && isEmailVerified()) || isAdmin();
      }

      /**
       * @description Subcollection for Vendor-specific profile data.
       */
      match /vendorProfile/{profileId} {
        allow read: if true;
        allow create: if isOwner(userId) && isEmailVerified() && request.resource.data.userId == userId;
        allow update: if (isExistingOwner(userId) && isEmailVerified() && request.resource.data.userId == userId) || isAdmin();
        allow delete: if (isOwner(userId) && isEmailVerified()) || isAdmin();
      }
    }

    /**
     * @description Global administrative role verification.
     */
    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Categories for food items.
     */
    match /menuTypes/{menuTypeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Food items offered by vendors.
     */
    match /menuItems/{menuItemId} {
      allow get, list: if true;
      allow create: if isEmailVerified() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isEmailVerified() && (resource.data.vendorId == request.auth.uid || isAdmin());
      allow delete: if isEmailVerified() && (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    /**
     * @description Customer pre-orders.
     */
    match /orders/{orderId} {
      allow get: if (resource != null && isInvolvedInOrder(resource.data)) || isAdmin();
      allow list: if (isEmailVerified() && (resource.data.customerId == request.auth.uid || resource.data.vendorId == request.auth.uid)) || isAdmin();
      allow create: if isEmailVerified() && request.resource.data.customerId == request.auth.uid;
      allow update: if resource != null && (isInvolvedInOrder(resource.data) || isAdmin());
      allow delete: if isAdmin();

      match /orderItems/{orderItemId} {
        allow get, list: if isInvolvedInOrder(get(/databases/$(database)/documents/orders/$(orderId)).data) || isAdmin();
        allow create, update, delete: if isInvolvedInOrder(get(/databases/$(database)/documents/orders/$(orderId)).data) || isAdmin();
      }
    }

    /**
     * @description Ratings and written reviews.
     */
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isEmailVerified() && request.resource.data.customerId == request.auth.uid;
      allow update: if resource != null && isEmailVerified() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow delete: if resource != null && isEmailVerified() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    /**
     * @description Reports submitted by vendors.
     */
    match /reports/{reportId} {
      allow get: if (isEmailVerified() && resource.data.reportingVendorId == request.auth.uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isEmailVerified() && request.resource.data.reportingVendorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
